# Public Supabase project values. Only use the anon key from browser code.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never prefix this value with NEXT_PUBLIC_ or import it in client code.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Reserved for the later provider activation payment integration.
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-server-only-razorpay-key-secret

# Reference placeholders only. Configure these as Supabase Edge Function secrets
# with `supabase secrets set`; do not copy them into Vercel or browser env vars.
EMAILJS_SERVICE_ID=your-emailjs-service-id
EMAILJS_TEMPLATE_ID=your-emailjs-template-id
EMAILJS_PUBLIC_KEY=your-emailjs-public-key
EMAILJS_PRIVATE_KEY=your-emailjs-private-key
SEND_EMAIL_HOOK_SECRETS=v1,whsec_your-supabase-hook-secret
APP_SITE_URL=https://mydabbaa.vercel.app

# Reserved for later transactional email integrations outside Auth.
RESEND_API_KEY=your-server-only-resend-api-key
